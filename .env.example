# Porta HTTP do servidor backend (Express)
PORT=3001

# Ambiente de execução: development ou production
NODE_ENV=development

# Segredo para assinar os tokens de leitura com HMAC. Substitua por um valor aleatório de 32 bytes em produção.
TOKEN_HMAC_SECRET=substitua-por-segredo-aleatorio-de-32-bytes-em-producao

# Validade padrão de uma carta, em dias
LETTER_TTL_DAYS=30

# Janela de tolerância, em minutos, para retomar uma sessão de leitura interrompida
SESSION_GRACE_MINUTES=10

# Tempo de vida, em segundos, do heartbeat da sessão de leitura
HEARTBEAT_TTL_SECONDS=120

# Inatividade, em segundos, até apagar texto e assets (padrão 600 = 10 minutos)
IDLE_TIMEOUT_SECONDS=600

# Prazo absoluto padrão por carta, em segundos (cada carta pode escolher 60..3600)
DEFAULT_READ_TIME_LIMIT_SECONDS=600

# Número máximo de requisições por janela de limitação de taxa
RATE_LIMIT_MAX=30

# Duração da janela de limitação de taxa, em milissegundos
RATE_LIMIT_WINDOW_MS=60000

# URL pública da aplicação, usada para montar os links das cartas
PUBLIC_APP_URL=http://localhost:5173

# Domínio atendido pelo Caddy no deploy (localhost usa certificado interno)
ENTRELINHAS_DOMAIN=localhost
