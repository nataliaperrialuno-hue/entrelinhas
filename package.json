{
  "name": "entrelinhas",
  "version": "0.1.0",
  "private": true,
  "description": "Cartas digitais com leitura única e apagamento progressivo",
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev -w @entrelinhas/frontend",
    "dev:backend": "npm run dev -w @entrelinhas/backend",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "ci": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.8"
  },
  "overrides": {
    "vite": "7.3.8"
  }
}
